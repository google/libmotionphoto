<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:padding="8dp">

    <!-- Left Pane: Media Preview Player & Still View or Scrollable Logs -->
    <FrameLayout
        android:id="@+id/fl_preview_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/white"
        app:layout_constraintHorizontal_weight="3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_title">

        <!-- Tab 1: Preview (PlayerView + ImageView) -->
        <FrameLayout
            android:id="@+id/ll_result_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <androidx.media3.ui.PlayerView
                android:id="@+id/pv_result_video"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                app:use_controller="false"
                app:resize_mode="fit"/>

            <ImageView
                android:id="@+id/iv_result_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:background="#CCCCCC"/>
        </FrameLayout>

        <!-- Tab 1 Placeholder: Shown when preview tab selected but not built yet -->
        <TextView
            android:id="@+id/tv_preview_placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/placeholder_building"
            android:visibility="gone"/>

        <!-- Tab 2: Logs (Hidden initially) -->
        <ScrollView
            android:id="@+id/sv_logs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#EEEEEE"
            android:padding="6dp"
            android:visibility="gone">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_log"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="10sp"
                    android:padding="8dp"
                    android:text="@string/placeholder_logs" />
            </HorizontalScrollView>
        </ScrollView>
    </FrameLayout>

    <!-- Right Pane: Header, Tabs, Playback Controls, and Action Buttons -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/title_creator_result"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="4dp"
        android:paddingBottom="2dp"
        app:layout_constraintHorizontal_weight="2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/fl_preview_container"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- TABS (Preview first, Logs second) -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintStart_toEndOf="@id/fl_preview_container"
        app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_preview" />
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_logs" />
    </com.google.android.material.tabs.TabLayout>

    <ScrollView
        android:id="@+id/sv_controls"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tab_layout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/fl_preview_container"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <FrameLayout
                android:id="@+id/fl_play_pause_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_play_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_play_motion"
                    app:icon="@android:drawable/ic_media_play"
                    app:cornerRadius="20dp"
                    app:backgroundTint="@color/google_blue"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pause_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_pause_motion"
                    app:icon="@android:drawable/ic_media_pause"
                    app:cornerRadius="20dp"
                    app:backgroundTint="@color/google_blue"
                    android:visibility="gone"/>
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_show_still"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/btn_show_still"
                app:icon="@android:drawable/ic_menu_gallery"
                app:cornerRadius="20dp"
                app:backgroundTint="@color/google_red"
                android:layout_marginTop="4dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/fl_play_pause_container"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_creator_download"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/btn_download_motion_photo"
                android:layout_marginTop="4dp"
                android:visibility="gone"
                app:icon="@android:drawable/ic_menu_save"
                app:cornerRadius="20dp"
                app:backgroundTint="@color/google_green"
                app:layout_constraintTop_toBottomOf="@id/btn_show_still"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_back_to_capture"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/btn_back_to_capture"
                android:layout_marginTop="4dp"
                app:cornerRadius="20dp"
                android:textColor="@color/google_blue"
                app:strokeColor="@color/google_blue"
                app:layout_constraintTop_toBottomOf="@id/btn_creator_download"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_back_to_build"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/btn_back_to_build"
                android:layout_marginTop="2dp"
                app:cornerRadius="20dp"
                android:textColor="@color/google_grey"
                app:strokeColor="@color/google_grey"
                app:layout_constraintTop_toBottomOf="@id/btn_back_to_capture"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
