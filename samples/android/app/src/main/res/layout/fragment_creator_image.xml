<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Step 1: Select Image"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_select_image"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Select Image"
        app:cornerRadius="24dp"
        app:backgroundTint="@color/google_blue"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_default_image"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Use Default Image"
        app:cornerRadius="24dp"
        android:textColor="@color/google_grey"
        app:strokeColor="@color/google_grey"
        app:layout_constraintTop_toBottomOf="@id/btn_select_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tv_image_path"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="No image selected"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/btn_default_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/iv_image_preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitCenter"
        android:background="#DDDDDD"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_image_path"
        app:layout_constraintBottom_toTopOf="@+id/btn_back_to_triage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_back_to_triage"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Main Menu"
        android:layout_marginEnd="4dp"
        app:cornerRadius="24dp"
        android:textColor="@color/google_grey"
        app:strokeColor="@color/google_grey"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_next_to_video"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_next_to_video"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Next"
        android:layout_marginStart="4dp"
        app:cornerRadius="24dp"
        app:backgroundTint="@color/google_green"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_back_to_triage"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
