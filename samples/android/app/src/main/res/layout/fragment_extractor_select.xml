<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Step 1: Select Photo to Extract"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_select_extract_photo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Select Photo"
        app:cornerRadius="24dp"
        app:backgroundTint="@color/google_blue"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_default_extract_photo"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Use Default Photo"
        app:cornerRadius="24dp"
        android:textColor="@color/google_grey"
        app:strokeColor="@color/google_grey"
        app:layout_constraintTop_toBottomOf="@id/btn_select_extract_photo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tv_extract_photo_path"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="No photo selected"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/btn_default_extract_photo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/iv_extract_photo_preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitCenter"
        android:background="#DDDDDD"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_extract_photo_path"
        app:layout_constraintBottom_toTopOf="@+id/cv_plugin_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_plugin_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/google_red"
        app:cardBackgroundColor="#F8F9FA"
        app:layout_constraintBottom_toTopOf="@+id/btn_extract_back_to_triage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/sw_disable_3p_plugins"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Disable 3P Plugins"
                android:textStyle="bold"
                android:textSize="16sp"
                android:checked="true"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:id="@+id/tv_disable_plugins_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Disables third-party plugins for safer metadata extraction."
                android:textSize="12sp"
                android:textColor="@color/google_grey"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@id/sw_disable_3p_plugins"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_extract_back_to_triage"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Main Menu"
        android:layout_marginEnd="4dp"
        app:cornerRadius="24dp"
        android:textColor="@color/google_grey"
        app:strokeColor="@color/google_grey"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_start_extract"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_start_extract"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Extract"
        android:layout_marginStart="4dp"
        app:cornerRadius="24dp"
        app:backgroundTint="@color/google_green"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_extract_back_to_triage"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
